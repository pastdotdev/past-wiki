# A project key from your past console (Settings › API keys). Never a management key.
PAST_API_KEY=past_sk_...

# Where past runs: https://api.past.dev for the cloud, or your self-hosted URL.
PAST_BASE_URL=https://api.past.dev

# Who the wiki reads as. A read sees project-wide knowledge plus this identity's audiences.
PAST_IDENTITY=wiki

# Optional. Shown in the header so readers know which project they are looking at.
WIKI_TITLE=Team wiki

# Optional app-side article generation. Without a key, show recalled evidence.
OPENROUTER_API_KEY=
# Optional: uses your OpenRouter account default when blank.
OPENROUTER_MODEL=
